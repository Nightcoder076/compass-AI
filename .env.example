# COMPASS AI Environment Configuration
# OpenAI API Key (Required for live AI agent execution & web research)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Hindsight Memory Configuration
HINDSIGHT_API_KEY=your-hindsight-key
HINDSIGHT_ENVIRONMENT=production

# Supabase PostgreSQL Configuration (Optional - embedded persistent store active by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Settings
NEXT_PUBLIC_APP_NAME="COMPASS AI"
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
